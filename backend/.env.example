APP_ENV=local
DATABASE_MODE=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_DB_URL=postgresql+psycopg://postgres.your-project-ref:<db-password>@aws-0-your-region.pooler.supabase.com:6543/postgres
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:5173

# Provide Snowflake values before enabling the Snowflake adapter.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_ROLE=ROLE_APPLICATION
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SUPPLY_CHAIN_ONTOLOGY
SNOWFLAKE_SCHEMA=SEMANTIC
